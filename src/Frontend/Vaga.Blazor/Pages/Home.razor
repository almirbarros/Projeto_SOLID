@page "/"

<PageTitle>Início - Sistema de Gestão de Vagas</PageTitle>

<div class="home-container">
    <!-- Bloco de Destaque / Apresentação -->
    <div class="banner-destaque">
        <div class="banner-conteudo">
            <h1 class="banner-titulo">Sistema de Gestão de Oportunidades</h1>
            <p class="banner-subtitulo">
                Plataforma fullstack desenvolvida com foco em alta performance, código limpo e arquitetura escalável,
                promovendo a transformação social através do gerenciamento inclusivo de vagas.
            </p>
            <hr class="divisor" />

            <!-- Cartão do Autor Profissional -->
            <div class="cartao-autor">
                <div class="autor-avatar">👨‍💻</div>
                <div class="autor-info">
                    <h6 class="autor-tag">Autor do Projeto</h6>
                    <h4 class="autor-nome">Almir Barros</h4>
                    <p class="autor-cargo">Analista de Sistemas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumo dos Recursos do Sistema -->
    <div class="recursos-grid">
        <div class="recurso-card">
            <div class="recurso-corpo">
                <div class="recurso-titulo texto-azul">⚡ API RESTful (.NET 10)</div>
                <p class="recurso-texto">
                    Backend construído com <strong>C# 10</strong> e <strong>.NET 10</strong>, expondo endpoints
                    padronizados e totalmente documentados através do <strong>Swagger (OpenAPI)</strong>.
                </p>
            </div>
        </div>

        <div class="recurso-card">
            <div class="recurso-corpo">
                <div class="recurso-titulo texto-verde">🌿 Diversidade & SOLID</div>
                <p class="recurso-texto">
                    Regras de negócio isoladas usando o princípio da responsabilidade única. Validações fluídas com
                    <strong>FluentValidation</strong> e suporte nativo a vagas afirmativas.
                </p>
            </div>
        </div>

        <div class="recurso-card">
            <div class="recurso-corpo">
                <div class="recurso-titulo texto-laranja">🎨 Blazor Fullstack SPA</div>
                <p class="recurso-texto">
                    Interface de usuário modular e reativa usando <strong>Blazor WebAssembly</strong>, permitindo o
                    ciclo completo de cadastro, edição horizontal compacta e remoção dinâmica de registros.
                </p>
            </div>
        </div>
    </div>

    <!-- Seção de Engenharia e Qualidade -->
    <div class="barra-engenharia">
        <div class="engenharia-info">
            <h5 class="engenharia-titulo">⚙️ Engenharia de Software Aplicada</h5>
            <p class="engenharia-subtitulo">Repository Pattern • Inversion of Control • In-Memory DB • xUnit / Moq</p>
        </div>
        <a href="cadastrar-vaga" class="btn-começar">Começar Apresentação</a>
    </div>
</div>
