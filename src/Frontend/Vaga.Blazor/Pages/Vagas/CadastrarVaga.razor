@page "/cadastrar-vaga"
@using Vaga.Blazor.Models
@using Vaga.Domain.Enums
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="cadastro-container">
    <h3>Cadastrar Nova Vaga</h3>

    @if (errosValidacao != null && errosValidacao.Any())
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var erro in errosValidacao)
                {
                    <li>@erro</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="@formModel" OnValidSubmit="ExecutarCadastro">
        <div class="form-group mb-3">
            <label>Título da Vaga</label>
            <InputText @bind-Value="formModel.Titulo" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label>Descrição</label>
            <InputTextArea @bind-Value="formModel.Descricao" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label>Tipo de Vaga</label>
            <InputSelect @bind-Value="formModel.TipoVaga" class="form-control">
                @foreach (var tipo in Enum.GetValues<TipoVaga>())
                {
                    <option value="@tipo">@tipo.ToString()</option>
                }
            </InputSelect>
        </div>

        <div class="form-group mb-3">
            <label>Data de Início</label>
            <InputDate @bind-Value="formModel.DataInicio" class="form-control" />
        </div>

        <div class="form-group mb-3">
            <label>Data de Término</label>
            <InputDate @bind-Value="formModel.DataFim" class="form-control" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox @bind-Value="formModel.EhVagaAfirmativa" id="ehAfirmativa" class="form-check-input" />
            <label class="form-check-label" for="ehAfirmativa">Esta é uma vaga afirmativa?</label>
        </div>

        <button type="submit" class="btn btn-primary">Salvar Vaga</button>
    </EditForm>
</div>

@code {
    private VagaFormModel formModel = new VagaFormModel();
    private List<string> errosValidacao = new List<string>();

    private async Task ExecutarCadastro()
    {
        errosValidacao.Clear();
        
        var response = await Http.PostAsJsonAsync("api/vagas", formModel);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/vagas-publicadas");
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.BadRequest)
        {
            var erros = await response.Content.ReadFromJsonAsync<List<string>>();
            if (erros != null) 
            {
                errosValidacao = erros;
            }
        }
    }
}
