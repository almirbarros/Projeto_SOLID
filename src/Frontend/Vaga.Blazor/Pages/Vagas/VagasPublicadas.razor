@page "/vagas-publicadas"
@using Vaga.Blazor.Models
@using Vaga.Blazor.Components
@inject HttpClient Http

<div class="vagas-container">
    <h3 class="titulo-pagina">Oportunidades Publicadas</h3>
    <p class="subtitulo-pagina">Gerencie as vagas ativas no sistema.</p>

    @if (!string.IsNullOrEmpty(mensagemErroTela))
    {
        <div class="alert alert-danger font-weight-bold p-3 mb-3">
            ⚠️ <strong>Diagnóstico do Front-end:</strong> @mensagemErroTela
        </div>
    }

    @if (errosEdicao.Any())
    {
        <div class="alert-erros">
            <ul>
                @foreach (var erro in errosEdicao)
                {
                    <li>@erro</li>
                }
            </ul>
        </div>
    }

    @if (vagas == null)
    {
        <div class="spinner-carregando" role="status"><span>Carregando...</span></div>
    }
    else if (!vagas.Any())
    {
        <div class="alert-info">Nenhuma vaga foi publicada ainda.</div>
    }
    else
    {
        <div class="controles-painel">
            <label class="ordenacao-label" for="selectOrdenacao">Ordenar por:</label>
            <select id="selectOrdenacao" class="form-select-ordenacao" @onchange="OnOrdenacaoMudou">
                <option value="Nome">🔤 Nome / Título</option>
                <option value="DataInicio">📅 Data de Início</option>
                <option value="DataFim">📆 Data de Término</option>
            </select>
        </div>

        <div class="vagas-grid">
            @foreach (var vaga in VagasOrdenadas)
            {
                var estaExpirada = vaga.DataFim.Date < DateTime.Today;

                <div class="vaga-card @(estaExpirada ? "card-desabilitado" : "")">
                    <div class="card-corpo">
                        <div class="card-conteudo">
                            <h5 class="card-titulo">
                                @vaga.Titulo
                                @if (estaExpirada)
                                {
                                    <span class="badge-expirado">🛑 Expirada</span>
                                }
                            </h5>
                            <p class="card-descricao">@vaga.Descricao</p>

                            <div class="badges-grupo">
                                <span class="badge-tipo">@vaga.TipoVaga.ToString()</span>
                                @if (vaga.EhVagaAfirmativa)
                                {
                                    <span class="badge-afirmativa">🌿 Vaga Afirmativa</span>
                                }
                            </div>

                            <div class="datas-info">
                                <span>Início: @vaga.DataInicio.ToString("dd/MM/yyyy")</span>
                                <span>Término: @vaga.DataFim.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <div class="card-acoes">
                            <button class="btn-editar" @onclick="() => IniciarEdicao(vaga)">✏️ Editar</button>
                            <button class="btn-remover" @onclick="() => ConfirmarRemover(vaga.Id)">🗑️ Remover</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- COMPONENTE DECLARATIVO E ISOLADO DO MODAL -->
    <EditarVagaModal Exibir="@exibirModal"
                     Id="@idVagaParaEditar"
                     Model="@modelParaEditar"
                     OnConfirmar="FinalizarEdicaoComSucesso"
                     OnCancelar="FecharModalEdicao" />
                     
</div>

@code {
    private List<VagaResponseDto>? vagas;
    private string criterioOrdenacao = "Nome";
    private List<string> errosEdicao = new();
    private string mensagemErroTela = string.Empty;

    // Estados de controle do Modal
    private bool exibirModal = false;
    private Guid idVagaParaEditar;
    private VagaFormModel modelParaEditar = new VagaFormModel();

    // Ciclo de vida reativo moderno para evitar perdas de estado assíncronas
    protected override async Task OnParametersSetAsync()
    {
        if (vagas == null)
        {
            await CarregarVagas();
        }
    }

    private async Task CarregarVagas()
    {
        try 
        { 
            mensagemErroTela = "Iniciando chamada para a API...";
            StateHasChanged();

            var options = new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            };
            options.Converters.Add(new System.Text.Json.Serialization.JsonStringEnumConverter());

            // Chamada com rota direta para isolar falhas de configuração do BaseAddress
            var response = await Http.GetAsync("http://localhost:5194/api/vagas");

            if (response.IsSuccessStatusCode)
            {
                vagas = await response.Content.ReadFromJsonAsync<List<VagaResponseDto>>(options);
                mensagemErroTela = string.Empty; 
            }
            else
            {
                mensagemErroTela = $"A API recusou a requisição. Código HTTP: {response.StatusCode} - {response.ReasonPhrase}";
                vagas = new List<VagaResponseDto>();
            }
        }
        catch (Exception ex)
        { 
            mensagemErroTela = $"Falha de conexão ou desserialização: {ex.Message} -> {ex.InnerException?.Message}";
            vagas = new List<VagaResponseDto>(); 
        }
        finally
        {
            StateHasChanged();
        }
    }

    private IEnumerable<VagaResponseDto> VagasOrdenadas => criterioOrdenacao switch
    {
        "DataInicio" => vagas?.OrderBy(v => v.DataInicio) ?? Enumerable.Empty<VagaResponseDto>(),
        "DataFim" => vagas?.OrderBy(v => v.DataFim) ?? Enumerable.Empty<VagaResponseDto>(),
        _ => vagas?.OrderBy(v => v.Titulo) ?? Enumerable.Empty<VagaResponseDto>()
    };

    private void OnOrdenacaoMudou(ChangeEventArgs e) => criterioOrdenacao = e.Value?.ToString() ?? "Nome";

    private void IniciarEdicao(VagaResponseDto vaga)
    {
        errosEdicao.Clear();
        idVagaParaEditar = vaga.Id;
        
        modelParaEditar = new VagaFormModel
        {
            Titulo = vaga.Titulo,
            Descricao = vaga.Descricao,
            TipoVaga = vaga.TipoVaga,
            EhVagaAfirmativa = vaga.EhVagaAfirmativa,
            DataInicio = vaga.DataInicio,
            DataFim = vaga.DataFim
        };

        exibirModal = true; 
        StateHasChanged();
    }

    private void FecharModalEdicao()
    {
        exibirModal = false;
        StateHasChanged();
    }

    private async Task FinalizarEdicaoComSucesso()
    {
        exibirModal = false;
        vagas = null; // Força o OnParametersSetAsync a buscar novos dados
        await CarregarVagas();
    }

    private async Task ConfirmarRemover(Guid id)
    {
        var response = await Http.DeleteAsync($"http://localhost:5194/api/vagas/{id}");
        if (response.IsSuccessStatusCode)
        {
            vagas = null;
            await CarregarVagas();
        }
    }
}
